# Google Cloud Secret Manager Configuration
# The server queries Secret Manager dynamically via Application Default Credentials (ADC).
GCP_PROJECT_ID=""
GEMINI_SECRET_NAME="GEMINI_API_KEY"
GEMINI_SECRET_VERSION="latest"

# GEMINI_API_KEY: Fallback for local sandbox testing if Secret Manager is not active.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Firebase Authentication)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
